// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                String            @id @default(uuid())
  nombre           String
  apellido         String
  email            String            @unique
  password         String
  role            String
  telefono         String?
  documentoIdentidad String
  tipoDocumento    String
  activo           Boolean           @default(true)
  ultimoAcceso     DateTime?
  fechaCreacion    DateTime          @default(now())
  fechaActualizacion DateTime        @updatedAt
  
  // Relaciones
  eventosAuditoria EventoAuditoria[]
  revisiones       Revision[]        @relation("Revisor")
  contratos        Contrato[]        @relation("Contratista")
  cuentasCobro     CuentaCobro[]    @relation("Contratista")
  comentarios      Comentario[]      @relation("AutorComentario")
  pagos            Pago[]
  notificaciones   Notificacion[]           
}


model Contrato {
  id              String       @id @default(uuid())
  numero          String       @unique
  objeto          String
  valor           Float
  documentosRequeridos  Json?
  fechaInicio     DateTime
  fechaFin        DateTime
  estado          String      @default("ASIGNADO")
  tipoContrato    String
  metadatos       Json?       // Agregado campo metadatos que faltaba
  fechaCreacion   DateTime    @default(now())
  fechaActualizacion DateTime @updatedAt
  
  // Relaciones
  contratista     Usuario     @relation("Contratista", fields: [contratistaId], references: [id])
  contratistaId   String
  cuentasCobro    CuentaCobro[]
  documentos      Documento[]

  @@index([contratistaId])
}

model CuentaCobro {
  id                String       @id @default(uuid())
  numeroCuenta      String      @unique
  valor             Float
  documentosRequeridos  Json?
  periodoInicio     DateTime
  periodoFin        DateTime
  estado            String      @default("CREADA")
  descripcionActividades String
  datosBancarios    Json
  fechaRadicacion   DateTime?
  fechaCreacion     DateTime    @default(now())
  fechaActualizacion DateTime   @updatedAt
  
  // Relaciones
  contrato          Contrato    @relation(fields: [contratoId], references: [id])
  contratoId        String
  contratista       Usuario     @relation("Contratista", fields: [contratistaId], references: [id])
  contratistaId     String
  revisiones        Revision[]
  documentos        Documento[]
  pagos             Pago[]

  @@index([contratoId])
  @@index([contratistaId])
}

model Revision {
  id              String       @id @default(uuid())
  observaciones   String?
  fechaCreacion   DateTime    @default(now())
  estado          String

  // Relaciones
  cuentaCobro     CuentaCobro @relation(fields: [cuentaCobroId], references: [id])
  cuentaCobroId   String
  revisor         Usuario     @relation("Revisor", fields: [revisorId], references: [id])
  revisorId       String
  comentarios     Comentario[]

  @@index([cuentaCobroId])
  @@index([revisorId])
}

model Comentario {
  id            String    @id @default(uuid())
  contenido     String
  fechaCreacion DateTime  @default(now())
  
  // Relaciones
  revision      Revision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  revisionId    String
  usuario       Usuario   @relation("AutorComentario", fields: [usuarioId], references: [id])
  usuarioId     String

  @@index([revisionId])
  @@index([usuarioId])
}

model Pago {
  id              String       @id @default(uuid())
  valor           Float
  fechaPago       DateTime?
  estado          String
  metodoPago      String
  referenciaPago  String?
  comprobante     String?
  observaciones   String?
  fechaCreacion   DateTime    @default(now())
  
  // Relaciones
  cuentaCobro     CuentaCobro @relation(fields: [cuentaCobroId], references: [id])
  cuentaCobroId   String     
  financiero      Usuario     @relation(fields: [financieroId], references: [id])
  financieroId     String 


  @@index([cuentaCobroId])
  @@index([financieroId])
}


model Documento {
  id              String   @id @default(uuid())
  nombre          String
  tipo            String
  url             String       // Ruta o URL del archivo
  descripcion     String?
  fechaSubida     DateTime     @default(now())

  // Relaciones opcionales (puede pertenecer a un contrato o una cuenta de cobro, pero no ambas)
  contrato        Contrato?     @relation(fields: [contratoId], references: [id])
  contratoId      String?

  cuentaCobro     CuentaCobro?  @relation(fields: [cuentaCobroId], references: [id])
  cuentaCobroId   String?

  @@index([contratoId])
  @@index([cuentaCobroId])
}

model EventoAuditoria {
  id            String   @id @default(uuid())
  accion        String             // Ejemplo: "CREAR_CONTRATO"
  descripcion   String?            // Detalle adicional de la acción
  fecha         DateTime @default(now())
  metadatos     Json?              // Datos adicionales relacionados al evento

  // Relación con Usuario
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId     String

  @@index([usuarioId])
}

model Notificacion {
  id            String   @id @default(uuid())
  asunto        String
  contenido     String
  read          Boolean  @default(false)
  fechaCreacion     DateTime    @default(now())
  fechaActualizacion DateTime   @updatedAt

  //Relacion con Usuario
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId     String

  @@index([usuarioId])
}