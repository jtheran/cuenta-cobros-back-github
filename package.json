{
  "name": "lsvbasenode",
  "version": "1.0.0",
  "description": "backend base de nodejs para poryectos, cuenta con jwt y passport, ademas de un orm de nodejs",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "prisma:init": "prisma init --datasource-provider database",
    "prisma:migrate": "prisma migrate dev --name name-migration",
    "prisma:studio": "prisma studio",
    "test": "jest --coverage --config --detectOpenHandles",
    "test:filter": "jest --testPathPattern= --coverage --config --detectOpenHandles"
  },
  "repository": {
    "type": "git",
    "url": "http://gitlab.lsv-tech.com/jtheran/lsvbasenodejs.git"
  },
  "keywords": [
    "express",
    "cors",
    "nodejs",
    "jwt",
    "passport",
    "prisma",
    "nodemon",
    "morgan",
    "logger"
  ],
  "author": "JMTB",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "faker": "^6.6.6",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "lsvbasenode": "file:",
    "mongoose": "^8.2.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.8.1",
    "qr-image": "^3.2.0",
    "qrcode-terminal": "^0.12.0",
    "supertest": "^6.3.4",
    "whatsapp-web.js": "^1.23.0",
    "winston": "^3.11.0",
    "wwebjs-mongo": "^1.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "jest-html-reporters": "^3.1.7",
    "morgan": "^1.10.0",
    "nodemon": "^3.0.3"
  }
}
